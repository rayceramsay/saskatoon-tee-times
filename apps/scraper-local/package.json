    "node-cron": "^4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stt/eslint-config": "workspace:*",
    "@stt/typescript-config": "workspace:*",
    "@types/node": "^26.1.0",
    "eslint": "^9.39.1",
    "tsx": "^4.8.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
