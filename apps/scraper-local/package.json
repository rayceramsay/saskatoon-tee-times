{
  "name": "scraper-local",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
